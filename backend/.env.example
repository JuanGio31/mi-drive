# Servidor
PORT=3000
NODE_ENV=dev

# Base de datos
# Sin autenticación (desarrollo local)
MONGO_URI=mongodb://localhost:27017/dms

# Con autenticación (reemplaza la línea anterior)
# MONGO_URI=mongodb://dms_app:TU_CLAVE@localhost:27017/dms?authSource=admin

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10

# CORS, multiples dominios separados por comas
CORS_ORIGIN=http://localhost:4200

# Logs tecnicos
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_DAYS=14
LOG_TO_FILE=true