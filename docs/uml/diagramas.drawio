  <diagram id="gIhS8s_Kqw7UxR3lmuV6" name="sec-papelera">
    <mxGraphModel dx="8983" dy="5758" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor P as Propietario\n    participant SPA as SPA Angular\n    participant API as API / ArchivoController o CarpetaController\n    participant PS as Servicio de papelera\n    participant DB as MongoDB\n    participant ACT as ActividadService\n\n    alt Enviar a papelera\n        P-&gt;&gt;SPA: Confirma el envío a papelera\n        SPA-&gt;&gt;API: DELETE /api/archivos/:id o /api/carpetas/:id\n        API-&gt;&gt;PS: enviar(id, usuarioId)\n        PS-&gt;&gt;DB: Validar propietario y estado del recurso\n\n        alt No existe, no es propietario o ya está en papelera\n            Note over PS: 404 sin acceso&lt;br/&gt;403 sin ser propietario&lt;br/&gt;400 si ya está en papelera\n            PS--&gt;&gt;API: Error de validación\n            API--&gt;&gt;SPA: HTTP 400, 403 o 404\n        else Recurso válido\n            alt Es carpeta\n                PS-&gt;&gt;DB: Enviar el subárbol a papelera en cascada\n            else Es archivo\n                PS-&gt;&gt;DB: Marcar el archivo como raíz y enviarlo a papelera\n            end\n            PS-&gt;&gt;ACT: Registrar envío a papelera\n            ACT-&gt;&gt;DB: Insertar actividad\n            PS--&gt;&gt;API: Operación completada\n            API--&gt;&gt;SPA: HTTP 204\n            SPA--&gt;&gt;P: Recarga la vista de papelera\n        end\n    else Restaurar\n        P-&gt;&gt;SPA: Confirma la restauración\n        SPA-&gt;&gt;API: POST /api/archivos/:id/restaurar o /api/carpetas/:id/restaurar\n        API-&gt;&gt;PS: restaurar(id, usuarioId)\n        PS-&gt;&gt;DB: Validar propietario, raíz de papelera y padre disponible\n\n        alt No es raíz o el padre no está disponible\n            PS--&gt;&gt;API: 400 solicitud inválida\n            API--&gt;&gt;SPA: HTTP 400\n        else Restauración válida\n            alt Es carpeta\n                PS-&gt;&gt;DB: Restaurar el subárbol y limpiar su estado\n            else Es archivo\n                PS-&gt;&gt;DB: Restaurar el archivo y limpiar su estado\n            end\n            PS-&gt;&gt;ACT: Registrar restauración\n            ACT-&gt;&gt;DB: Insertar actividad\n            PS--&gt;&gt;API: Recurso restaurado\n            API--&gt;&gt;SPA: HTTP 200\n            SPA--&gt;&gt;P: Recarga la vista\n        end\n    else Eliminar permanentemente\n        P-&gt;&gt;SPA: Confirma la eliminación permanente\n        SPA-&gt;&gt;API: DELETE /api/archivos/:id/permanente o /api/carpetas/:id/permanente\n        API-&gt;&gt;PS: eliminarPermanente(id, usuarioId)\n        PS-&gt;&gt;DB: Validar propietario y que sea la raíz de papelera\n\n        alt No está en papelera o no es la raíz\n            Note over PS: 404 sin acceso&lt;br/&gt;403 sin ser propietario&lt;br/&gt;400 si no es la raíz\n            PS--&gt;&gt;API: Error de validación\n            API--&gt;&gt;SPA: HTTP 400, 403 o 404\n        else Eliminación válida\n            alt Es carpeta\n                PS-&gt;&gt;DB: Eliminar archivos y carpetas del subárbol\n            else Es archivo\n                PS-&gt;&gt;DB: Eliminar el documento\n            end\n            PS-&gt;&gt;ACT: Registrar eliminación permanente\n            ACT-&gt;&gt;DB: Insertar actividad\n            PS--&gt;&gt;API: Operación completada\n            API--&gt;&gt;SPA: HTTP 204\n            SPA--&gt;&gt;P: Recarga la vista\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="mY_jO0rLh5R1948IAV2W-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Propietario" mermaidId="n:P" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Propietario" id="mY_jO0rLh5R1948IAV2W-2">
