  <diagram id="3mc3fD7HaJpnkDI4exf1" name="sec-compartir">
    <mxGraphModel dx="4146" dy="2658" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor P as Propietario\n    participant SPA as SPA Angular\n    participant API as API / ArchivoController\n    participant CS as Servicio de compartición\n    participant DB as MongoDB\n    participant ACT as ActividadService\n\n    P-&gt;&gt;SPA: Abre \&quot;Compartir\&quot; y elige usuario y permiso\n    SPA-&gt;&gt;API: POST /api/archivos/:id/compartir\n    API-&gt;&gt;API: Valida el body con Zod\n    API-&gt;&gt;CS: compartir(id, dto, usuarioId)\n    CS-&gt;&gt;DB: Cargar recurso y validar propiedad\n\n    alt Sin acceso o no es propietario\n        Note over CS: 404 si no tiene acceso&lt;br/&gt;403 si tiene acceso pero no es propietario\n        CS--&gt;&gt;API: 404 o 403\n        API--&gt;&gt;SPA: HTTP 404 o 403\n    else Es propietario\n        CS-&gt;&gt;CS: Validar que el destino no sea el mismo usuario\n        CS-&gt;&gt;DB: Validar usuario destino activo\n\n        alt Destino inválido\n            Note over CS: 400 si es el mismo usuario&lt;br/&gt;404 si no existe o está inactivo\n            CS--&gt;&gt;API: 400 o 404\n            API--&gt;&gt;SPA: HTTP 400 o 404\n        else Destino válido\n            CS-&gt;&gt;DB: Crear o actualizar compartición\n            CS-&gt;&gt;ACT: Registrar compartición\n            ACT-&gt;&gt;DB: Insertar actividad\n            CS--&gt;&gt;API: Recurso actualizado\n            API--&gt;&gt;SPA: HTTP 200\n            SPA--&gt;&gt;P: Muestra confirmación\n        end\n    end\n\n    Note over API: El flujo equivalente aplica a&lt;br/&gt;POST /api/carpetas/:id/compartir&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="hCLof4AzkZMegtoCvmCM-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
