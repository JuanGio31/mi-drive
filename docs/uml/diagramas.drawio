  <diagram id="n8r7H3LWJZQgyYE6l_hY" name="sec-acceso-req-compartido">
    <mxGraphModel dx="5133" dy="3290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor U as Usuario\n    participant SPA as SPA Angular\n    participant API as API / ArchivoController\n    participant S as ArchivoService\n    participant PS as Permisos\n    participant AR as ArchivoRepository\n    participant CR as CarpetaRepository\n    participant DB as MongoDB\n\n    U-&gt;&gt;SPA: Abre un archivo compartido\n    SPA-&gt;&gt;API: GET /api/archivos/:id\n    API-&gt;&gt;S: buscarPorId(id, usuarioId)\n    S-&gt;&gt;PS: obtenerConAcceso(id, usuarioId)\n    PS-&gt;&gt;AR: buscarPorId(id)\n    AR-&gt;&gt;DB: Consultar archivo\n    DB--&gt;&gt;AR: Archivo\n\n    alt Archivo inexistente, en papelera o sin permiso\n        PS--&gt;&gt;S: 404 no encontrado\n        S--&gt;&gt;API: 404\n        API--&gt;&gt;SPA: HTTP 404\n        SPA--&gt;&gt;U: Muestra recurso no disponible\n    else Archivo accesible\n        PS-&gt;&gt;PS: Buscar compartición directa\n\n        alt Compartición directa o propietario\n            PS-&gt;&gt;PS: Usar permiso directo\n        else Sin compartición directa\n            PS-&gt;&gt;CR: Obtener ancestros de carpetaPadre\n            CR-&gt;&gt;DB: Consultar cadena de carpetas\n            DB--&gt;&gt;CR: Ancestros\n            PS-&gt;&gt;PS: Usar el permiso del ancestro más cercano\n        end\n\n        alt Sin permiso efectivo\n            PS--&gt;&gt;S: 404 no encontrado\n            S--&gt;&gt;API: 404\n            API--&gt;&gt;SPA: HTTP 404\n        else Con permiso efectivo\n            S-&gt;&gt;PS: obtenerPermiso([archivo], usuarioId)\n            PS--&gt;&gt;S: Permiso efectivo\n            S--&gt;&gt;API: archivo + miPermiso\n            API--&gt;&gt;SPA: HTTP 200\n            SPA--&gt;&gt;U: Muestra archivo y acciones permitidas\n        end\n    end\n\n    Note over API: Para GET /api/carpetas/:id se usa el flujo equivalente&lt;br/&gt;con CarpetaService y CarpetaPermisosService&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="MmDXlHHdxNlIVOYnMJ7V-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontFamily=Helvetica;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Usuario" mermaidId="n:U" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Usuario" id="MmDXlHHdxNlIVOYnMJ7V-2">
