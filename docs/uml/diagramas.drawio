  <diagram id="CT2A9VMLfJ3wprzltR-e" name="secuencia-inicio-sesion">
    <mxGraphModel dx="1893" dy="2303" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor U as Usuario\n    participant SPA as SPA Angular\n    participant API as API / AuthController\n    participant AS as AuthService\n    participant DB as MongoDB\n    participant ACT as ActividadService\n\n    U-&gt;&gt;SPA: Ingresa correo y contraseña\n    SPA-&gt;&gt;API: POST /api/auth/sign-in\n    API-&gt;&gt;API: Valida el body con Zod\n    API-&gt;&gt;AS: signIn(dto)\n    AS-&gt;&gt;DB: Buscar usuario por correo con su hash\n    DB--&gt;&gt;AS: Usuario o null\n\n    alt Credenciales inválidas o usuario inactivo\n        Note over AS: 401 si no existe, si la contraseña es incorrecta&lt;br/&gt;o si el usuario está desactivado\n        AS--&gt;&gt;API: Error de autenticación\n        API--&gt;&gt;SPA: HTTP 401\n        SPA--&gt;&gt;U: Muestra el error\n    else Credenciales válidas\n        AS-&gt;&gt;AS: bcrypt.compare(password, passwordHash)\n        AS-&gt;&gt;AS: Firmar JWT con expiración de 7 días\n        AS-&gt;&gt;ACT: Registrar inicio de sesión\n        ACT-&gt;&gt;DB: Insertar actividad\n        AS--&gt;&gt;API: { token, usuario }\n        API--&gt;&gt;SPA: HTTP 200\n        SPA-&gt;&gt;SPA: Guarda token y usuario en localStorage\n        SPA--&gt;&gt;U: Redirige a /home\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="TMfe1S_pbryvEosuP0Sf-1">
