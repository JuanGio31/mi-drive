  <diagram id="k00yQ4QKgpaDbsWCn6kh" name="sec-crear-editar-archivo">
    <mxGraphModel dx="5133" dy="3290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor U as Usuario\n    participant SPA as SPA Angular\n    participant API as API / ArchivoController\n    participant S as ArchivoService\n    participant DB as MongoDB\n    participant ACT as ActividadService\n\n    alt Crear archivo\n        U-&gt;&gt;SPA: Completa nombre y tipo de archivo\n        SPA-&gt;&gt;API: POST /api/archivos\n        API-&gt;&gt;API: Valida el body con Zod\n        API-&gt;&gt;S: crear(dto, usuarioId)\n\n        opt Hay carpeta padre\n            S-&gt;&gt;DB: Validar permiso de edición y obtener el propietario del árbol\n        end\n\n        S-&gt;&gt;DB: Validar nombre único en la ubicación\n\n        alt Nombre duplicado\n            S--&gt;&gt;API: 409 conflicto\n            API--&gt;&gt;SPA: HTTP 409\n            SPA--&gt;&gt;U: Muestra el error\n        else Nombre disponible\n            S-&gt;&gt;DB: Insertar archivo\n            S-&gt;&gt;ACT: Registrar creación\n            ACT-&gt;&gt;DB: Insertar actividad\n            S--&gt;&gt;API: Archivo creado\n            API--&gt;&gt;SPA: HTTP 201\n            SPA--&gt;&gt;U: Abre o muestra el archivo\n        end\n    else Editar contenido\n        U-&gt;&gt;SPA: Modifica el contenido y guarda\n        SPA-&gt;&gt;API: PUT /api/archivos/:id/contenido\n        API-&gt;&gt;API: Valida el body con Zod\n        API-&gt;&gt;S: actualizarContenido(id, dto, usuarioId)\n        S-&gt;&gt;DB: Cargar archivo y resolver permiso efectivo\n\n        alt Sin acceso al recurso\n            S--&gt;&gt;API: 404 no encontrado\n            API--&gt;&gt;SPA: HTTP 404\n        else Sin permiso de edición\n            S--&gt;&gt;API: 403 prohibido\n            API--&gt;&gt;SPA: HTTP 403\n        else Permiso de edición\n            S-&gt;&gt;DB: Actualizar contenido y tamanio\n            S-&gt;&gt;ACT: Registrar actualización\n            ACT-&gt;&gt;DB: Insertar actividad\n            S--&gt;&gt;API: Archivo actualizado\n            API--&gt;&gt;SPA: HTTP 200\n            SPA--&gt;&gt;U: Confirma el guardado\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="e1G6J3GwaAfUA3a-Tl7h-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
